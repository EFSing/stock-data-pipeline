    "fill_rules": [
      "open > ceiling => SKIP_GAP_ABOVE_CEILING",
      "trigger <= open <= ceiling => fill at open",
      "open < trigger and high >= trigger => fill at trigger",
      "high < trigger => NOT_TRIGGERED"
