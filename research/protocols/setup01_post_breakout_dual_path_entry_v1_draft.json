      "upper": "H1 + 0.25 * ATR14(breakout_day)"
    },
    "running_leg_fib": {
      "anchor_low": "H1",
      "anchor_high": "max(high[breakout_day:t-1])",
      "minimum_leg": "anchor_high - H1 >= 0.5 * ATR14(breakout_day)",
      "lower": "anchor_high - 0.618 * (anchor_high - H1)",
      "upper": "anchor_high - 0.382 * (anchor_high - H1)",
