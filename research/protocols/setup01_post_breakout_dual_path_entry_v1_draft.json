    "same_session_lower_zone_fallback_after_gap_through": false
  },
  "signal_packages": {
    "PRICE_ACTION_ONLY": {
      "continuation": [
        "no prior or current active-zone touch",
        "close > H1",
        "close > previous_high",
        "close > open",
        "abs(close-open)/(high-low) >= 0.50",
        "(close-low)/(high-low) >= 0.75"
      ],
      "retest": [
        "session range intersects the active zone frozen before the session",
        "close > active_zone.upper",
        "close > open",
        "close > previous_close",
        "abs(close-open)/(high-low) >= 0.35",
        "(close-low)/(high-low) >= 0.70"
      ],
      "volume_role": "RVOL20 diagnostic only"
    },
    "PRICE_PLUS_RVOL": {
      "base": "PRICE_ACTION_ONLY",
      "additional_gate": "volume_t / median(volume[t-20:t-1]) >= 1.20",
      "missing_or_nonpositive_volume": "FAIL_CLOSED"
    },
    "parallel_or_selection_forbidden": true,
    "selected": null
