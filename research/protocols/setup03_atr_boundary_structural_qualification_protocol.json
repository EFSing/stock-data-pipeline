{
  "schema_version": "setup03-atr-boundary-structural-qualification-v1",
  "protocol_version": "SETUP_03-ATR-BOUNDARY-STRUCTURAL-QUALIFICATION-2026-08-29-v1",
  "phase": "Phase 5J-v5",
  "official_name": "SETUP_03_ATR_NORMALIZED_PLATFORM_BOUNDARY_REDESIGN",
  "status": "ATR_BOUNDARY_PROTOCOL_FROZEN_NOT_EXECUTED",
  "research_scope": "LAST_INDEPENDENT_DEVELOPMENT_HOLDOUT_STRUCTURE_ONLY",
  "objective": "Test one finite ATR-normalized platform-boundary family for structural stability without reading outcomes or selecting a production rule.",
  "boundary_semantics": {
    "mode": "ATR_NORMALIZED",
    "atr": {
      "indicator": "WILDER_ATR",
      "period": 14,
      "reference_timestamp": "current_as_of_bar_t",
      "reference_value": "atr[t] computed from bars with index <= t",
      "aggregation": "Wilder recursive smoothing seeded by the first 14 true ranges after the initial bar",
      "non_positive_or_warmup": "platform gate fails with ATR_UNAVAILABLE",
      "future_data_prohibited": true
    },
    "cluster_width": {
      "high": "max(causally_available_confirmed_high_prices) - min(causally_available_confirmed_high_prices)",
      "low": "max(causally_available_confirmed_low_prices) - min(causally_available_confirmed_low_prices)",
      "denominator": "the same causal ATR[t] for high and low",
      "normalized_high": "high_cluster_width / ATR[t]",
      "normalized_low": "low_cluster_width / ATR[t]",
      "comparison": "both normalized widths must be <= the same candidate threshold",
      "asymmetry": "not allowed",
      "minimum_swing_counts": 2,
      "breakout_anchor": "unchanged max confirmed high price",
      "invalidation_anchor": "unchanged min confirmed low price"
    },
    "candidate_thresholds_atr": [1.0, 1.5, 2.0, 2.5],
    "candidate_count": 4,
    "candidate_order": "ascending_threshold",
    "fixed_setup_parameters": {
      "swing_lookback": 5,
      "platform_window": 40,
      "arm_proximity_pct": 0.0
    },
    "unchanged_semantics": [
      "causal_swing_confirmation",
      "strict_as_of_replay",
      "range_or_transition_structure_gate",
      "platform_lifecycle",
      "breakout_close_greater_than_frozen_high",
      "structural_invalidation_close_less_than_frozen_low",
      "confirmed_failed_terminal_event_semantics",
      "decision_engine",
      "entry_zone_stop_target_rr",
      "execution",
      "terminal_rearm_orchestration"
    ]
  },
  "incumbent_reference": {
    "role": "single_descriptive_reference_only",
    "mode": "PERCENTAGE",
    "tolerances_pct": [0.03, 0.04, 0.05],
    "search": false,
    "qualification_gate": false,
    "production_change": false
  },
  "independent_holdout_selection": {
    "source": "A1 v2 committed source snapshots and metadata only",
    "new_seed": "SETUP_03-ATR-BOUNDARY-CLEAN-HOLDOUT-SHA256-SEED-2026-08-29-v1",
    "cohort_order": {
      "CN": ["CSI300", "CSI500", "CSI1000"],
      "US": ["SP500", "NASDAQ100", "SOX", "IGV"]
    },
    "quota_by_market_and_cohort": {
      "CN": {"CSI300": 6, "CSI500": 7, "CSI1000": 7},
      "US": {"SP500": 5, "NASDAQ100": 5, "SOX": 5, "IGV": 5}
    },
    "exclusions_before_ranking": [
      "Phase 5K-A1 formal universe identities",
      "development universe v1 identities",
      "Phase 5J-v3 second development holdout identities",
      "any identity used by the candidate-design evidence manifests"
    ],
    "ranking": {
      "algorithm": "SHA-256",
      "input_template": "new_seed|market|cohort|canonical_identity",
      "sort_order": "digest_ascending_then_canonical_identity_ascending",
      "result_independent": true,
      "metadata_only": true,
      "replacement_after_results": false
    },
    "target_counts": {"CN": 20, "US": 20, "total": 40},
    "freeze_rule": "freeze universe manifest and hash before any new OHLCV request or SETUP_03 evaluation"
  },
  "qualification": {
    "scope": "CN and US independently; no market compensation",
    "candidate_level": [
      {"id": "minimum_confirmed_events_per_market_candidate", "operator": ">=", "threshold": 8, "unit": "events"},
      {"id": "minimum_event_symbols_per_market_candidate", "operator": ">=", "threshold": 8, "unit": "symbols"},
      {"id": "maximum_symbol_confirmed_concentration", "operator": "<=", "threshold": 0.25, "unit": "share"},
      {"id": "maximum_symbol_confirmed_hhi", "operator": "<=", "threshold": 0.20, "unit": "HHI"},
      {"id": "zero_confirmed_event_pathology", "operator": "=", "threshold": false, "unit": "boolean"}
    ],
    "adjacent_pair": [
      {"id": "adjacent_confirmed_jaccard", "operator": ">=", "threshold": 0.60, "unit": "share"},
      {"id": "adjacent_confirmed_retention", "operator": ">=", "threshold": 0.80, "unit": "share"},
      {"id": "added_event_rate", "operator": "<=", "threshold": 0.50, "unit": "added/current events"},
      {"id": "disappeared_event_rate", "operator": "<=", "threshold": 0.50, "unit": "disappeared/previous events"},
      {"id": "matched_confirmed_event_date_drift_median", "operator": "<=", "threshold": 5, "unit": "trading sessions"},
      {"id": "matched_confirmed_event_date_drift_p90", "operator": "<=", "threshold": 15, "unit": "trading sessions"},
      {"id": "lifecycle_divergence_rate", "operator": "<=", "threshold": 0.50, "unit": "divergent/max lifecycle count"}
    ],
    "event_identity": "(market, canonical_symbol, confirmed_date)",
    "event_matching": {
      "exact_retained_first": true,
      "residual_scope": "same market and same canonical symbol",
      "maximum_trading_session_distance": 40,
      "objective": ["maximum_cardinality", "minimum_total_trading_session_distance", "lexicographically_smallest_pair_sequence"],
      "order_preserving": true,
      "non_crossing": true,
      "unmatched_included_in": ["jaccard", "retention", "added_event_rate", "disappeared_event_rate"]
    },
    "lifecycle_identity": {
      "per_symbol_order": "terminal bar index, then terminal type, then detected bar index",
      "ordinal": "one-based within market and canonical symbol",
      "changed_fields": ["terminal_type", "terminal_date", "detected_index", "breakout_price", "structural_invalidation"],
      "divergence_count": "unmatched old + unmatched new + retained ordinals with any changed field",
      "divergence_rate_denominator": "max(previous lifecycle count, current lifecycle count, 1)"
    },
    "reproducibility": {
      "required": true,
      "method": "repeat the same frozen input and protocol once and require identical canonical artifact digest",
      "failure_is": "qualification failure"
    },
    "candidate_survival": "candidate-level checks and every incident adjacent-pair check must pass in both CN and US",
    "selection_tie_break": "lowest threshold among surviving candidates; if more than one remains, highest worst-case adjacent Jaccard, then lowest worst-case lifecycle divergence, then lowest threshold",
    "production_selection": false,
    "outcome_metrics": false
  },
  "stop_and_decision": {
    "pass": "SETUP_03_BOUNDARY_REDESIGN_SURVIVES_INDEPENDENT_DEVELOPMENT",
    "pass_next": "READY_FOR_FORMAL_VALIDATION",
