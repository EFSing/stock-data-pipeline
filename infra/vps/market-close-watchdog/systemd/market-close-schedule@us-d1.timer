[Unit]
Description=Stock data pipeline us-d1 schedule

[Timer]
OnCalendar=Tue..Sat *-*-* 09:40:00 Asia/Shanghai
OnCalendar=Tue..Sat *-*-* 09:55:00 Asia/Shanghai
OnCalendar=Tue..Sat *-*-* 11:05:00 Asia/Shanghai
AccuracySec=1s
Unit=market-close-schedule@us-d1.service

[Install]
WantedBy=timers.target
