[Unit]
Description=Stock data pipeline cn-report schedule

[Timer]
OnCalendar=Mon..Fri *-*-* 17:45:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 18:00:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 18:30:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 20:05:00 Asia/Shanghai
AccuracySec=1s
Unit=market-close-schedule@cn-report.service

[Install]
WantedBy=timers.target
