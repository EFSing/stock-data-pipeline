[Unit]
Description=Stock data pipeline cn-d1 schedule

[Timer]
OnCalendar=Mon..Fri *-*-* 18:40:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 18:55:00 Asia/Shanghai
OnCalendar=Mon..Fri *-*-* 20:05:00 Asia/Shanghai
AccuracySec=1s
Unit=market-close-schedule@cn-d1.service

[Install]
WantedBy=timers.target
