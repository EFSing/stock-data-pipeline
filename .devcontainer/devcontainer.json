{
  "name": "Trading Decision System",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt && pip install pytest",
  "containerEnv": {
    "TZ": "Asia/Shanghai"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false,
        "editor.formatOnSave": false
      }
    }
  },
  "remoteEnv": {
    "GOOGLE_SHEET_ID": "${localEnv:GOOGLE_SHEET_ID}",
    "GOOGLE_SERVICE_ACCOUNT_JSON": "${localEnv:GOOGLE_SERVICE_ACCOUNT_JSON}"
  }
}
